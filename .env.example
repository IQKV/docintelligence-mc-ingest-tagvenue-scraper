# ====== Defaults (all optional) ======
# Discovery mode: sitemap | search | urls-file
TV_MODE=sitemap

# Filter params (search mode)
TV_CITY=
TV_COUNTRY=
TV_PEOPLE=
TV_DATE=
TV_TIME_FROM=
TV_TIME_TO=
TV_MIN_PRICE=
TV_MAX_PRICE=

# Page/limit
TV_PAGE=1
TV_LIMIT=100
TV_URLS_FILE=

# Sitemap-specific options (sitemap mode only)
# Only include rooms whose sitemap lastmod >= this value.
# Accepts an ISO date (e.g. 2024-06-01) or a relative shorthand (7d, 2w, 1m).
# Entries with no lastmod are always included. Leave blank to scrape everything.
TV_SITEMAP_SINCE=
# Maximum number of paginated sitemap-rooms-N.xml pages to fetch (default: 100)
TV_SITEMAP_MAX_PAGES=100

# Concurrency & Rate control
TV_CONCURRENCY=5
TV_MIN_DELAY_MS=600
TV_JITTER_MS=400
TV_TIMEOUT_MS=15000
TV_RETRIES=3

# Network
TV_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
TV_PROXY=

# Browser mode (optional, requires playwright installed)
TV_BROWSER=false
TV_BROWSER_STEALTH=true

# Output
TV_OUTPUT_DIR=/data
TV_OUTPUT_FILE=

# Runtime
TV_LOG_LEVEL=info
TV_LOG_FILE=
TV_DRY_RUN=false
