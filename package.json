{
  "name": "@iqkv/venueintelligence-mc-ingest-tagvenue-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Tagvenue.com venue and room listing scraper. Produces canonical master venue-compatible JSON for ingestion into the Shortlisty Intelligence venue registry.",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "venueintelligence-mc-ingest-tagvenue-scraper": "./bin/scrape.js"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "start": "node ./bin/scrape.js",
    "dev": "node --watch ./bin/scrape.js --log-level debug",
    "cli:help": "node ./bin/scrape.js --help",
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "lint": "pnpm lint:oxlint",
    "lint:oxlint": "oxlint",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky",
    "release": "release-it --ci",
    "test": "echo \"No tests yet\" && exit 0",
    "typecheck": "tsc -p jsconfig.json --noEmit || true"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "minimist": "^1.2.8",
    "p-queue": "^8.0.1",
    "p-throttle": "^6.2.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier-plugin-packagejson": "^3.0.2",
    "release-it": "^21.0.0",
    "release-it-pnpm": "^4.6.6",
    "sort-package-json": "^4.0.0"
  },
  "optionalDependencies": {
    "hpagent": "^1.2.0",
    "playwright": "^1.45.3"
  },
  "lint-staged": {
    "*": [
      "pnpm formatter:check"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.2"
}
